#################################################
# VOYAGES
#################################################

### ---------------- Créer un voyage ------------------------------ ###
# Le voyageid est capturé automatiquement dans @voyageid ci-dessous.

# @name creerVoyage
POST {{baseUrl}}/voyages
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "voyage": {
        "titre": "Vacances au Japon",
        "dateDeb": "{{$datetime 'YYYY-MM-DD' 1 d}}T00:00:00.000Z",
        "dateFin": "{{$datetime 'YYYY-MM-DD' 12 d}}T00:00:00.000Z"
    },
    "etape": {
        "dateDeb": "{{$datetime 'YYYY-MM-DD' 1 d}}T00:00:00.000Z",
        "dateFin": "{{$datetime 'YYYY-MM-DD' 5 d}}T00:00:00.000Z",
        "hebergement": "Hotel",
        "destinationId": 1,
        "notes": "Première étape"
    }
}

###

@voyageid = {{creerVoyage.response.body.result.voyage.id}}
@premiereEtapeId = {{creerVoyage.response.body.result.etape.id}}

### -------------- Créer un voyage - champs manquants - 400 ------------- ###

POST {{baseUrl}}/voyages
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "voyage": {
        "titre": "Voyage incomplet",
        "dateDeb": "2026-09-01T00:00:00.000Z",
        "dateFin": "2026-09-10T00:00:00.000Z"
    },
    "etape": {
        "dateDeb": "2026-09-01T00:00:00.000Z",
        "dateFin": "2026-09-03T00:00:00.000Z"
    }
}

###

### ------- Créer un voyage - dates étape hors bornes du voyage - 400 ---- ###

POST {{baseUrl}}/voyages
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "voyage": {
        "titre": "Voyage dates invalides",
        "dateDeb": "2026-09-01T00:00:00.000Z",
        "dateFin": "2026-09-10T00:00:00.000Z"
    },
    "etape": {
        "dateDeb": "2026-08-25T00:00:00.000Z",
        "dateFin": "2026-09-03T00:00:00.000Z",
        "hebergement": "Hotel",
        "destinationId": 1
    }
}

###

### ---------- Récupérer tous les voyages de l'utilisateur connecté ------------ ###

GET {{baseUrl}}/voyages/moi
Authorization: Bearer {{tokenVoyageur}}

###

### ------------------- Modifier un voyage ----------------------------- ###

PATCH {{baseUrl}}/voyages/{{voyageid}}
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "titre": "Voyage Japon Été 2026",
    "dateFin": "{{$datetime 'YYYY-MM-DD' 15 d}}T00:00:00.000Z"
}

###

### -------- Modifier un voyage - nouvelle date de fin invalide - 400 --- ###

PATCH {{baseUrl}}/voyages/{{voyageid}}
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "dateFin": "{{$datetime 'YYYY-MM-DD' -30 d}}T00:00:00.000Z"
}

###

### -------------- Modifier un voyage - id inexistant - 404 -------------- ###

PATCH {{baseUrl}}/voyages/id-inexistant
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "titre": "Voyage fantôme"
}


#################################################
# ETAPES
#################################################

### ---------------- Récupérer toutes les étapes d'un voyage --------------- ###

GET {{baseUrl}}/etapes/moi/{{voyageid}}
Authorization: Bearer {{tokenVoyageur}}

###

### ----------------- Ajouter une étape au voyage ---------------------------###
# L'etapeid est capturé automatiquement dans @etapeid ci-dessous.

# @name ajouterEtape
POST {{baseUrl}}/etapes/{{voyageid}}
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "dateDeb": "{{$datetime 'YYYY-MM-DD' 6 d}}T00:00:00.000Z",
    "dateFin": "{{$datetime 'YYYY-MM-DD' 10 d}}T00:00:00.000Z",
    "hebergement": "AirBnB",
    "destinationId": 3,
    "notes": "Visite de Montréal"
}

###

@etapeid = {{ajouterEtape.response.body.id}}

### ------- Ajouter une étape - dates non contiguës à la précédente - 400 --- ###

POST {{baseUrl}}/etapes/{{voyageid}}
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "dateDeb": "{{$datetime 'YYYY-MM-DD' 13 d}}T00:00:00.000Z",
    "dateFin": "{{$datetime 'YYYY-MM-DD' 14 d}}T00:00:00.000Z",
    "hebergement": "Hotel",
    "destinationId": 1,
    "notes": "Étape non contiguë"
}

###

### -------------- Ajouter une étape - voyage introuvable - 404 ---------- ###

POST {{baseUrl}}/etapes/id-inexistant
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "dateDeb": "2026-08-10T00:00:00.000Z",
    "dateFin": "2026-08-12T00:00:00.000Z",
    "hebergement": "Hotel",
    "destinationId": 1
}

###

### -------------------- Modifier une étape ------------------------------ ###

PATCH {{baseUrl}}/etapes/{{voyageid}}/{{etapeid}}
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "hebergement": "Hotel",
    "notes": "Réservation modifiée"
}

###

### -------------- Modifier une étape - étape introuvable - 404 ---------- ###

PATCH {{baseUrl}}/etapes/{{voyageid}}/9999
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "hebergement": "Hotel"
}

###

### ------- Supprimer une étape qui n'est pas la dernière - 400 ---------- ###
# Testé AVANT la vraie suppression ci-dessous : à ce stade il reste 2 étapes,
# donc @premiereEtapeId (la toute première) n'est pas la dernière -> doit échouer.

DELETE {{baseUrl}}/etapes/{{voyageid}}/{{premiereEtapeId}}
Authorization: Bearer {{tokenVoyageur}}

###

### -------------------- Supprimer une étape ----------------------------- ###
# Supprime bien la dernière étape ({{etapeid}}) -> doit réussir.

DELETE {{baseUrl}}/etapes/{{voyageid}}/{{etapeid}}
Authorization: Bearer {{tokenVoyageur}}


### -------------------- Supprimer un voyage --------------------------- ###
# À exécuter en dernier : supprime le voyage utilisé par les tests d'étapes ci-dessus.

DELETE {{baseUrl}}/voyages/{{voyageid}}
Authorization: Bearer {{tokenVoyageur}}



#################################################
# VARIABLES
#################################################

@baseUrl = http://localhost:3000

@tokenAdmin =
@tokenVoyageur =

@voyageid =
@etapeid =

# ---- Dates dynamiques (relatives à aujourd'hui) ----
# open-meteo ne fournit des prévisions que jusqu'à 17 jours dans le futur.
# On utilise la variable dynamique native de REST Client {{$datetime "YYYY-MM-DD" N d}}
# (fonctionne directement avec "Send Request") pour que
# les dates du voyage/étapes principal restent toujours dans cette fenêtre,
# peu importe le jour où on lance test.rest.
# Le format date-seule (sans heure) + "T00:00:00.000Z" en dur garantit que
# deux requêtes séparées qui utilisent le même décalage en jours (ex: +5 j)
# donnent exactement la même valeur, même si elles sont envoyées à quelques
# minutes d'intervalle (important pour les règles de contiguïté des étapes).

#################################################
# AUTHENTIFICATION
#################################################

# ---------------------- Inscription (Admin) -------------------------- #
# Après cette requête : modifier le rôle en "Admin" (Prisma Studio, ou
# directement dans Neon via l'éditeur de table / SQL editor),
# puis relancer la connexion ci-dessous pour capturer un token Admin.

# @name inscriptionAdmin
POST {{baseUrl}}/auth/inscription
Content-Type: application/json

{
    "courriel": "sarah.meziane01@test.com",
    "motDePasse": "123456",
    "nom": "Meziane",
    "prenom": "Sarah"
}

###

# --------------- Inscription (Admin) - courriel déjà utilisé - 409 --------- #

POST {{baseUrl}}/auth/inscription
Content-Type: application/json

{
    "courriel": "sarah.meziane01@test.com",
    "motDePasse": "123456",
    "nom": "Meziane",
    "prenom": "Sarah"
}

###

# ------------------- Inscription - champs manquants - erreur -------------- #

POST {{baseUrl}}/auth/inscription
Content-Type: application/json

{
    "courriel": "incomplet@test.com",
    "motDePasse": "123456"
}

###

# ------------------------- Connexion (Admin) ------------------------- #
# Le token est capturé automatiquement dans @tokenAdmin ci-dessous.
# Ne fonctionne qu'après avoir modifié le rôle en base (Prisma Studio / Neon).

# @name connexionAdmin
POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "courriel":"sarah.meziane01@test.com",
    "motDePasse":"123456"
}

###

@tokenAdmin = {{connexionAdmin.response.body.token}}

# --------------------- Connexion (Admin) - mauvais mot de passe - 401 ------ #

POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "courriel":"sarah.meziane01@test.com",
    "motDePasse":"mauvaisMotDePasse"
}

###

# --------------------- Connexion - courriel inexistant - 401 -------------- #

POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "courriel":"inconnu@test.com",
    "motDePasse":"123456"
}

###

# ----------------------- Inscription (Voyageur) ---------------------- #

# @name inscriptionVoyageur
POST {{baseUrl}}/auth/inscription
Content-Type: application/json

{
    "courriel": "karim.benali01@test.com",
    "motDePasse": "123456",
    "nom": "Benali",
    "prenom": "Karim"
}

###

# ------------------------ Connexion (Voyageur) --------------------------- #

# @name connexionVoyageur
POST {{baseUrl}}/auth/connexion
Content-Type: application/json

{
    "courriel":"karim.benali01@test.com",
    "motDePasse":"123456"
}

###

@tokenVoyageur = {{connexionVoyageur.response.body.token}}


#################################################
# DESTINATIONS
#################################################

# ------------------ Ajouter une destination (Admin) ------------------ #

### Tokyo
POST {{baseUrl}}/destinations
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "ville": "Tokyo",
    "continent": "Asie"
}

###

### Paris
POST {{baseUrl}}/destinations
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
    "ville":"Paris",
    "continent":"Europe"
}

###

### Montréal
POST {{baseUrl}}/destinations
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
    "ville":"Montréal",
    "continent":"Amerique"
}

###

# ----------- Ajouter une destination (Voyageur) - accès refusé - 403 ------ #

POST {{baseUrl}}/destinations
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "ville": "Berlin",
    "continent": "Europe"
}

###

# ------------------ Ajouter une destination - ville manquante - 400 ------- #

POST {{baseUrl}}/destinations
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "continent": "Europe"
}

###

# ---------------- Ajouter une destination - continent invalide - 400 ------ #

POST {{baseUrl}}/destinations
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "ville": "Berlin",
    "continent": "Allemagne"
}

###

# --------------- Récupérer toutes les destinations -------------------- ###

GET {{baseUrl}}/destinations

###

# --------------  Filtrer les destinations par continent --------------- ###

GET {{baseUrl}}/destinations/continent?continent=Asie

###

# ------------- Filtrer les destinations - continent manquant - 400 -------- #

GET {{baseUrl}}/destinations/continent

###

# -------------- Récupérer une destination par son identifiant ---------- ###

GET {{baseUrl}}/destinations/1

###

# ---------- Récupérer une destination - id invalide - 400/404 ------------- #

GET {{baseUrl}}/destinations/abc

###

# ------------- Modifier une destination (Admin) ------------------------###

PATCH {{baseUrl}}/destinations/1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "ville": "Kyoto"
}

###

# ------- Modifier une destination (Voyageur) - accès refusé - 403 --------- #

PATCH {{baseUrl}}/destinations/1
Content-Type: application/json
Authorization: Bearer {{tokenVoyageur}}

{
    "ville": "Osaka"
}

###

# --------------- Modifier une destination inexistante - 404 --------------- #

PATCH {{baseUrl}}/destinations/9999
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "ville": "Nulle part"
}

###

# ------------ Supprimer une destination (Admin) ------------------------ ###

DELETE {{baseUrl}}/destinations/2
Authorization: Bearer {{tokenAdmin}}

###

# ---------------- Supprimer une destination inexistante - 404 ------------- #

DELETE {{baseUrl}}/destinations/9999
Authorization: Bearer {{tokenAdmin}}


